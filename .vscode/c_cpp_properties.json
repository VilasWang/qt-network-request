{
    "configurations": [
        {
            "name": "Win32-MSVC",
            "includePath": [
                "${workspaceFolder}/**",
                "${env.VCToolsInstallDir}include",
                "${env.WindowsSdkDir}Include/${env.WindowsSDKVersion}**",
                "${env:QT_DIR}/include/**",
                "${env:QT_DIR}/include/QtCore",
                "${env:QT_DIR}/include/QtWidgets",
                "${env:QT_DIR}/include/QtNetwork",
                "${env:QT_DIR}/include/QtXml"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "QT_CORE_LIB",
                "QT_WIDGETS_LIB",
                "QT_NETWORK_LIB",
                "QT_XML_LIB"
            ],
            "compilerPath": "${env:VCToolsInstallDir}bin/Hostx64/x64/cl.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-msvc-x64"
        }
    ],
    "version": 4
}
